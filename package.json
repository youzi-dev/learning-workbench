{
  "name": "growth-workbench",
  "productName": "学习工作台",
  "description": "围绕实际项目提供学习对话与学习记录的桌面工作台。",
  "author": {
    "name": "Learning Workbench contributors"
  },
  "version": "0.11.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && pnpm build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:capture": "node scripts/build-capture.mjs",
    "test:capture-egress": "node scripts/verify-capture-egress.mjs",
    "start:server": "node dist-server/cli.mjs serve",
    "verify:sqlite": "node scripts/verify-sqlite.mjs",
    "build": "pnpm build:main && vite build",
    "build:browser": "vite build --config vite.browser.config.ts && node scripts/build-browser-sw.mjs",
    "prepare:browser-asr": "node scripts/prepare-browser-asr.mjs",
    "preview:browser": "vite preview --config vite.browser.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:mac": "pnpm prepare:release-metadata && pnpm prepare:speech && pnpm build && electron-builder --mac dir",
    "package:mac:x64": "pnpm prepare:release-metadata && pnpm prepare:speech -- --platform darwin --arch x64 && pnpm build && electron-builder --mac dir --x64",
    "package:win": "pnpm prepare:release-metadata && pnpm prepare:speech -- --platform win32 --arch x64 && pnpm build && electron-builder --win dir --x64 --publish never --config.forceCodeSigning=false",
    "package:win:installer:unsigned": "pnpm prepare:release-metadata && pnpm prepare:speech -- --platform win32 --arch x64 && pnpm build && electron-builder --win nsis --x64 --publish never --config.forceCodeSigning=false --config.directories.output=release/windows-installer-unsigned-x64",
    "prepare:speech": "node scripts/prepare-speech.mjs",
    "test:voice-local": "cross-env VOICE_INTEGRATION=1 vitest run tests/voice-service.test.ts",
    "build:android": "vite build --config vite.android.config.ts",
    "sync:android": "cap sync android",
    "prepare:android-notices": "pnpm prepare:release-metadata && node scripts/prepare-android-notices.mjs",
    "package:android": "node scripts/android-release-config.mjs && pnpm build:android && pnpm prepare:android-notices && pnpm sync:android && cd android && ./gradlew assembleRelease",
    "verify:release": "node scripts/verify-release.mjs",
    "prepare:release-metadata": "node scripts/prepare-release-metadata.mjs",
    "test:release-packaging": "node --test tests/release-packaging.check.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "package:server": "node scripts/package-server.mjs"
  },
  "build": {
    "appId": "dev.growthworkbench.app",
    "productName": "学习工作台",
    "copyright": "Copyright (c) 2026 Learning Workbench contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-main/**",
      "package.json",
      "!node_modules/@capacitor/android{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "assets/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/speech/${os}-${arch}",
        "to": "speech"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "target": "dir",
      "identity": "-",
      "icon": "assets/icon.icns",
      "category": "public.app-category.education",
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "将你主动录制的语音在本机转成聊天草稿，不上传录音。"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "学习工作台",
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "learning-workbench-win-${arch}-unsigned-development-${version}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "createStartMenuShortcut": true,
      "shortcutName": "学习工作台",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "asar": true
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@noble/hashes": "2.4.0",
    "@vscode/codicons": "0.0.46-24",
    "diff": "^9.0.0",
    "monaco-editor": "^0.56.0",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "6.4.299",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  }
}
