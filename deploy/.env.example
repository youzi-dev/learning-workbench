# Copy to a private operator-owned .env (chmod 600). Never bake it into an image.
WORKBENCH_DOMAIN=
WORKBENCH_PLATFORM=
# Exact image ID sha256:<64 hex> or repository@sha256:<64 hex>, verified for the platform above.
WORKBENCH_WORKER_IMAGE=
# Unique across deployments on the same Docker daemon; stable across restarts.
WORKBENCH_DEPLOYMENT_ID=
# On the Linux host: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=
WORKBENCH_ALLOWED_ORIGINS=https://localhost
# Optional: add one HTTPS browser client origin, comma-separated after https://localhost.
WORKBENCH_COMPOSE_PROJECT=personal-workbench
WORKBENCH_IMAGE_TAG=local
# No credentials or capture secret belong here. Bootstrap creates a private random key volume.

# Optional offhost profile only: absolute dedicated private directory, never secret values.
# WORKBENCH_OFFHOST_DIRECTORY=/srv/workbench-offhost
