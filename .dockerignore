# Deny everything, then admit only prebuilt server artifacts and the exact image inputs.
**
!dist-server/
!dist-server/*.mjs
!dist-server/migrations/
!dist-server/migrations/*.sql
!deploy/
!deploy/server.Dockerfile
!deploy/Caddyfile
!licenses/
!licenses/Learning-Workbench-LICENSE.txt
# Preserve the existing prebuilt worker-image build contract.
!deploy/worker.Dockerfile
!deploy/egress-guard.sh
!deploy/capture-dist/
!deploy/capture-dist/worker.mjs
!deploy/capture-dist/proxy.mjs

!deploy/licenses/
!deploy/licenses/NOTICE.md
!deploy/licenses/restic-0.19.1-LICENSE.txt

